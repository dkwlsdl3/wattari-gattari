+import { StringDecoder } from 'node:string_decoder';
+
+// Only the public JSON reason is shown; thinking/tool payloads are never forwarded.
+export function createJudgeStream(provider, onText = () => {}) {
+  const decoder = new StringDecoder('utf8');
+  let pending = '', text = '', shown = '', result;
+  let dropping = false;
+  function publish(force = false) {
+    const match = /"reason"\s*:\s*"((?:[^"\\]|\\.)*)/.exec(text);
+    if (!match) return;
+    let reason;
+    try { reason = JSON.parse('"' + match[1] + '"').replace(/[\u0000-\u001f\u007f-\u009f]/g, ' ').slice(0, 1000); }
+    catch { return; } // A partial JSON escape will be completed by the next chunk.
+    if (reason === shown || (!force && shown && reason.length - shown.length < 16)) return;
+    shown = reason;
+    onText(reason);
+  }
+  function line(value) {
+    let event;
+    try { event = JSON.parse(value); } catch { return; }
+    if (!event || event.parent_tool_use_id) return;
+    if (provider === 'claude') {
+      if (event.type === 'stream_event' && event.event?.type === 'content_block_delta' && event.event.delta?.type === 'text_delta') {
+        text = (text + event.event.delta.text).slice(0, 16000);
+        publish();
+      } else if (event.type === 'result') {
+        if (event.is_error) { result = undefined; return; }
+        result = event.result;
+        if (typeof result === 'string') { text = result; publish(true); }
+      }
+    } else if (event.type === 'item.completed' && event.item?.type === 'agent_message' && typeof event.item.text === 'string') {
+      text = event.item.text;
+      publish(true);
+    }
+  }
+  return {
+    push(chunk) {
+      for (const part of decoder.write(chunk).split(/(?<=\n)/)) {
+        if (!dropping) pending += part;
+        if (pending.length > 128 * 1024) { pending = ''; dropping = true; }
+        if (part.endsWith('\n')) {
+          if (!dropping) line(pending);
+          pending = ''; dropping = false;
+        }
+      }
+    },
+    end() { pending += decoder.end(); if (!dropping && pending) line(pending); pending = ''; },
+    result() { return result; },
+  };
+}
