+// The transport is intentionally bounded and carries excerpts, never a claim of completeness.
+export function issueSnapshot(issues) {
+  const context = { issues: [] };
+  for (const issue of issues.slice(0, 3)) {
+    const snapshot = { iid: issue.iid, url: issue.url ?? '', fetchedAt: issue.fetchedAt,
+      updatedAt: issue.updatedAt ?? null, text: '', truncated: true };
+    context.issues.push(snapshot);
+    const points = Array.from(issue.text ?? '');
+    let low = 0, high = points.length;
+    while (low < high) {
+      const mid = Math.ceil((low + high) / 2);
+      snapshot.text = points.slice(0, mid).join('');
+      if (Buffer.byteLength(JSON.stringify(context), 'utf8') <= Math.floor(30 * 1024 * context.issues.length / Math.min(3, issues.length))) low = mid;
+      else high = mid - 1;
+    }
+    snapshot.text = points.slice(0, low).join('');
+    if (Buffer.byteLength(JSON.stringify(context), 'utf8') > 32 * 1024) { context.issues.pop(); break; }
+  }
+  return context;
+}
