+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { routeTask } from '../src/router.mjs';
+import { runCli } from '../src/cli.mjs';
+
+test('progress reports actual lookup and judge boundaries before the v1 result', async () => {
+  const events = [];
+  const routing = await routeTask({ provider: 'codex', prompt: '#201 검토', cwd: process.cwd(),
+    onProgress: event => events.push(event),
+    fetchIssue: async () => {
+      assert.match(events.at(-1).message, /조회 중/);
+      return { iid: '201', title: '복구', labels: [], description: '검토' };
+    },
+    judgeTask: async () => {
+      assert.equal(events.at(-1).stage, 'judge');
+      return { tier: 'complex', confidence: 'high', reason: '복구 검토 필요' };
+    },
+  });
+  assert.deepEqual(events.map(event => event.stage), ['prepare', 'issue', 'issue', 'judge', 'decision', 'decision']);
+  assert.equal(routing.contractVersion, 1);
+  assert.match(routing.reasons.at(-1), /복구 검토 필요/);
+});
+
+test('judge failure emits fallback and preserves rule routing', async () => {
+  const events = [];
+  const routing = await routeTask({ provider: 'codex', prompt: 'hello', cwd: process.cwd(),
+    onProgress: event => events.push(event), judgeTask: async () => { throw new Error('offline'); },
+  });
+  assert.equal(events.some(event => event.stage === 'fallback'), true);
+  assert.match(routing.warnings.at(-1), /offline/);
+});
+
+test('progress side channel is opt-in and never changes stdout result', async () => {
+  for (const enabled of [false, true]) {
+    let stdout = '', stderr = '';
+    const code = await runCli(['route', '--provider', 'codex', '--prompt', 'hello'], {
+      env: enabled ? { WAGA_ROUTER_PROGRESS: '1' } : {},
+      output: { write: text => { stdout += text; } },
+      errorOutput: { write: text => { stderr += text; } },
+      routeTaskImpl: async ({ onProgress }) => {
+        onProgress?.({ stage: 'judge', message: '대기' });
+        return { proof: true };
+      },
+    });
+    assert.equal(code, 0);
+    assert.deepEqual(JSON.parse(stdout), { proof: true });
+    assert.equal(stderr.startsWith('WAGA_ROUTER_PROGRESS '), enabled);
+  }
+});
