+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createJudgeStream } from '../src/judge-stream.mjs';
+import { judgeWithProviderCli } from '../src/judge.mjs';
+import { routeTask } from '../src/router.mjs';
+import { issueSnapshot } from '../src/issue-snapshot.mjs';
+
+const decision = { reason: '본문과 댓글의 동시성 복구 요구를 확인했습니다.', tier: 'complex', confidence: 'high' };
+const delta = text => JSON.stringify({ type: 'stream_event', event: { type: 'content_block_delta', delta: { type: 'text_delta', text } } }) + '\n';
+
+test('Claude reason streams before completion, ignores thinking, and preserves final validation', async () => {
+  const seen = [];
+  const result = await judgeWithProviderCli({ provider: 'claude', model: 'opus', effort: 'high', cwd: process.cwd(), prompt: 'judge',
+    onText: text => seen.push(text),
+    run: async (_, args, { onStdout }) => {
+      assert.ok(args.includes('stream-json'));
+      assert.ok(args.includes('--include-partial-messages'));
+      onStdout(Buffer.from(JSON.stringify({ type: 'stream_event', event: { type: 'content_block_delta', delta: { type: 'thinking_delta', thinking: 'private' } } })+'\n'));
+      const first = delta('{"reason":"본문과 댓글');
+      for (const byte of Buffer.from(first)) onStdout(Buffer.from([byte]));
+      assert.deepEqual(seen, ['본문과 댓글']);
+      const remaining = delta('의 동시성 복구 요구를 확인했습니다.","tier":"complex","confidence":"high"}');
+      onStdout(Buffer.from(remaining));
+      onStdout(Buffer.from(JSON.stringify({ type: 'result', result: JSON.stringify(decision) })+'\n'));
+      return { stdout: '', stderr: '' };
+    },
+  });
+  assert.deepEqual(result, decision);
+  assert.equal(seen.at(-1), decision.reason);
+  assert.ok(!seen.join('').includes('private'));
+});
+
+test('partial display never authorizes an incomplete or failed final result', async () => {
+  await assert.rejects(judgeWithProviderCli({ provider: 'claude', model: 'opus', effort: 'high', cwd: process.cwd(), prompt: 'judge', onText() {},
+    run: async (_, __, { onStdout }) => {
+      onStdout(Buffer.from(delta('{"reason":"partial')));
+      return { stdout: '', stderr: '' };
+    },
+  }));
+});
+
+test('Codex forwards only completed public agent messages', () => {
+  const seen = [];
+  const stream = createJudgeStream('codex', text => seen.push(text));
+  for (const type of ['reasoning', 'agent_message']) {
+    stream.push(Buffer.from(JSON.stringify({ type: 'item.completed', item: { id: 'item_0', type, text: JSON.stringify(decision) } })+'\n'));
+  }
+  stream.end();
+  assert.deepEqual(seen, [decision.reason]);
+});
+
+test('v2 returns the fetched issue excerpt with source and timestamp without a second lookup', async () => {
+  let fetches = 0;
+  const route = await routeTask({ provider: 'codex', prompt: '#201 검토', cwd: process.cwd(), includeContext: true,
+    fetchIssue: async () => { fetches++; return { iid: '201', title: '복구', description: '원문 증거', notes: [{ body: '댓글 증거' }],
+      web_url: 'https://gitlab.example/team/project/-/issues/201', updated_at: '2026-09-11T00:00:00Z' }; },
+    judgeTask: async ({ prompt }) => { assert.match(prompt, /원문 증거/); assert.match(prompt, /댓글 증거/); return decision; },
+  });
+  assert.equal(fetches, 1);
+  assert.equal(route.contractVersion, 2);
+  const issue = route.issueContext.issues[0];
+  assert.match(issue.text, /댓글 증거/);
+  assert.equal(issue.truncated, true);
+  assert.ok(Number.isFinite(Date.parse(issue.fetchedAt)));
+  assert.match(issue.url, /issues\/201$/);
+});
+
+test('snapshot transport is byte bounded even for multibyte or escaped issue text', () => {
+  const result = issueSnapshot(Array.from({ length: 3 }, (_, i) => ({ iid: String(i), fetchedAt: new Date().toISOString(), text: '한글"\\\n'.repeat(20000) })));
+  assert.ok(Buffer.byteLength(JSON.stringify(result)) <= 32 * 1024);
+  assert.equal(result.issues.length, 3);
+  assert.ok(result.issues.every(issue => issue.truncated));
+});
