# Replace absolute paths before installing as a systemd user service.
# This template is not installed by waga serve.
[Unit]
Description=Waga local browser workspace

[Service]
Type=simple
WorkingDirectory=/absolute/path/to/workspace
ExecStart=/absolute/path/to/node /absolute/path/to/wattari-gattari/src/cli.mjs serve --port 4317
Environment=PATH=/absolute/path/to/node-directory:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5
Nice=10
UMask=0077

[Install]
WantedBy=default.target
