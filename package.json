{
  "name": "wattari-gattari",
  "version": "0.3.0",
  "private": true,
  "description": "A thin cross-provider message bridge for native Codex and Claude Code sessions",
  "type": "module",
  "bin": {
    "waga": "src/cli.mjs"
  },
  "files": [
    "src",
    "demo",
    "docs",
    "integrations",
    "README.md",
    "README.ko.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "demo": "node src/demo.mjs",
    "demo:record": "vhs demo/wattari-gattari.tape",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "check": "find src test -name '*.mjs' -print0 | xargs -0 -n1 node --check && node --test && node src/demo.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "ws": "^8.18.3"
  }
}
